# Database connection used by MCP Toolbox
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=content_ops
DB_USER=postgres
DB_PASSWORD=postgres
ALLOYDB_CLUSTER_ID=my-alloydb-cluster
ALLOYDB_INSTANCE_ID=my-primary-inst

# Future app configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=global
ADK_RETRY_ATTEMPTS=3
ADK_RETRY_INITIAL_DELAY_SECONDS=1
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_BASE_DELAY_SECONDS=5
WORKFLOW_RETRY_MAX_DELAY_SECONDS=60

# Future storage/integration configuration
GCS_BUCKET_NAME=your-content-assets-bucket
GOOGLE_CALENDAR_ID=primary

# Hosted Gmail + Calendar service configuration used by the ADK app
WORKSPACE_SERVICE_URL=https://your-workspace-service.run.app
WORKSPACE_SERVICE_AUTH_TOKEN=

# Google Workspace OAuth/token configuration used by the hosted Gmail + Calendar service
GOOGLE_WORKSPACE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_WORKSPACE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_WORKSPACE_REDIRECT_URI=https://your-workspace-service.run.app/oauth/callback
GOOGLE_WORKSPACE_ALLOWED_SCOPES=https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.readonly
GOOGLE_WORKSPACE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_WORKSPACE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_WORKSPACE_SERVICE_AUTH_TOKEN=
